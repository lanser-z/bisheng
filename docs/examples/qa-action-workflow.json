          {
            "name": "执行代码",
            "params": [
              {"key": "code", "type": "code", "value": "import json\n\ndef main(llm_output: str) -> dict:\n    try:\n        result = json.loads(llm_output)\n        matched = result.get('matched_questions', [])\n        return {\n            'standard_question': result.get('standard_question', ''),\n            'matched_questions': matched,\n            'has_match': len(matched) > 0,\n            'question_count': len(matched)\n        }\n    except json.JSONDecodeError:\n        return {\n            'standard_question': '',\n            'matched_questions': [],\n            'has_match': False,\n            'question_count': 0\n        }", "required": true}
            ]
          },
          {
            "name": "出参",
            "params": [
              {"key": "code_output", "type": "code_output", "value": [{"key": "standard_question", "type": "str"}, {"key": "matched_questions", "type": "list"}, {"key": "has_match", "type": "bool"}, {"key": "question_count", "type": "int"}], "global": "code:value.map(el => ({ label: el.key, value: el.key }))", "required": true}
            ]
          }
