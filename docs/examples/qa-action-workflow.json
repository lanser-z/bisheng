        "name": "代码-执行动作",
        "type": "code",
        "description": "根据选中的问题执行对应动作",
        "group_params": [
          {
            "name": "入参",
            "params": [
              {"key": "code_input", "test": "input", "type": "code_input", "value": [{"key": "selected_json", "type": "ref", "label": "选择结果", "value": "llm_8i9j0.output"}, {"key": "qa_list", "type": "ref", "label": "原始问答列表", "value": "input_4c5d6.qa_list"}], "required": true}
            ]
          },
          {
            "name": "执行代码",
            "params": [
              {"key": "code", "type": "code", "value": "import json\n\ndef main(selected_json: str, qa_list: str) -> dict:\n    try:\n        selected = json.loads(selected_json)\n        qa_data = json.loads(qa_list) if isinstance(qa_list, str) else qa_list\n        \n        selected_id = selected.get('selected_id', '')\n        \n        answer = ''\n        action = None\n        for item in qa_data:\n            if str(item.get('id', '')) == str(selected_id):\n                answer = item.get('answer', '')\n                action = item.get('action')\n                break\n        \n        return {\n            'selected_id': selected_id,\n            'answer': answer,\n            'action': action,\n            'action_type': action.get('type') if action else 'text'\n        }\n    except Exception as e:\n        return {\n            'selected_id': '',\n            'answer': f'处理失败: {str(e)}',\n            'action': None,\n            'action_type': 'error'\n        }", "required": true}
            ]
          },
          {
            "name": "出参",
