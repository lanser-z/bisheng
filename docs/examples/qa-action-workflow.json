              {"key": "code_output", "type": "code_output", "value": [{"key": "selected_id", "type": "str"}, {"key": "answer", "type": "str"}, {"key": "action", "type": "dict"}, {"key": "action_type", "type": "str"}], "global": "code:value.map(el => ({ label: el.key, value: el.key }))", "required": true}
