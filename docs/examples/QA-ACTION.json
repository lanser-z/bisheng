1,"y":112.2269902758204},"selected":false},{"id":"llm_7e8f9","data":{"v":"2","id":"llm_7e8f9","tab":{"value":"single","options":[{"key":"single","label":"true"},{"key":"batch","label":"true"}]},"name":"LLM-问题匹配","type":"llm","description":"将口语化文字转为标准提问，并与问答列表匹配","group_params":[{"params":[{"key":"batch_variable","tab":"batch","help":"true","test":"var","type":"user_question","label":"true","value":[],"global":"self","linkage":"output","required":true,"placeholder":"true"}]},{"name":"模型设置","params":[{"key":"model_id","type":"bisheng_model","label":"true","value":1,"required":true,"placeholder":"true"},{"key":"temperature","step":0.1,"type":"slide","label":"true","scope":[0,2],"value":0.3}]},{"name":"提示词","params":[{"key":"system_prompt","test":"var","type":"var_textarea","label":"true","value":"# Role\n你是一个智能问答匹配专家。你的任务是将用户的口语化输入转换为标准提问，并从给定的问答列表中找出最匹配的问题。\n\n# Rules\n1. 首先将口语化文字转换为简洁、明确的标准提问\n2. 然后在问答列表中查找语义相似的问题\n3. 返回匹配度最高的问题列表（最多3个）\n4. 当前时间是{{#start_1a2b3.current_time#}},和时间相关的问题要参考当前时间作答\n\n# Input Format\n## 问题列表用json描述\n单元素列表格式如下，多元素列表中元素格式相同：\n[\n{\n\"qid\": str 问题ID\n\"question\": str 问题表述\n\"keyWord\": str 问题表述的同义句，多个同义句用分号分隔\n\"params\": list 问题参数\n  [\n  {\n  \"id\": str 参数ID\n  \"title\": str 参数名\n  \"keyWord\": str 参数名的同义词，多个同义词用逗号分隔\n  \"paramType\": str 参数类型，用于规范化提取到的参数值。有效值为：text、date、decimal\n  \"paramFormat\": str 参数格式，用于规范化提取到的参数值。当paramType为text或date时有效，空字符串代表无格式要求\n  \"isRequire\": str 是否必须提取到，Y 代表该参数必须提取，否则可省略\n  }\n  ]\n}\n]\n\n## 单元素列表示例\n[\n{\n\"qid\": \"12300\",\n\"question\": \"班组运行日报列表\",\n\"keyWord\": \"班组工作日报列表；班组日报列表\",\n\"params\": \n  [\n  {\n  \"id\": \"orgCode\",\n  \"title\": \"班组所属组织\",\n  \"keyWord\": \"公司，单位，部门，厂区\",\n  \"paramType\": \"text\",\n  \"paramFormat\": \"\",\n  \"isRequire\": \"Y\"\n  },\n  {\n  \"id\": \"dailyDate\",\n  \"title\": \"日报时间范围\",\n  \"keyWord\": \"年月日，今天，昨天，上周三\",\n  \"paramType\": \"date\",\n  \"paramFormat\": \"yyyy-MM-dd\",\n  \"isRequire\": \"Y\"\n  },\n  {\n  \"id\": \"service\",\n  \"title\": \"日报所属项目\",\n  \"keyWord\": \"项目，工作，业务\",\n  \"paramType\": \"text\",\n  \"paramFormat\": \"\",\n  \"isRequire\": \"Y\"\n  }\n  ]\n}\n]\n\n# Output Format\n严格按JSON格式输出：{  \"standard_question\": \"转换后的标准提问\",  \"matched_questions\": [    {\"qid\": \"问题ID\", \"question\": \"问题表述\", \"score\": 0.95}  ]}\n\n","varZh":{"start_1a2b3.current_time":"开始/current_time"}},{"key":"user_prompt","test":"var","type":"var_textarea","label":"true","value":"用户输入：{{#input_4c5d6.user_text#}}\n\n问答列表：\n{{#input_4c5d6.qa_list#}}","varZh":{"input_4c5d6.qa_list":"输入/qa_list","input_4c5d6.user_text":"输入/user_text"},"required":true},{"key":"image_prompt","help":"true","type":"image_prompt","label":"true","value":[]}]},{"name":"输出","params":[{"key":"output_user","help":"true","type":"switch","label":"true","value":false},{"key":"output","help":"true","type":"var","label":"true","value":[],"global":"code:value.map(el => ({ label: el.label, value: el.key }))"}]}]},"type":"flowNode","dragging":false,"measured":{"width":334,"height":836},"position":{"x":668.1419264722801,"y":190.26543907538849},"selected":false},{"id":"code_a1b2c","data":{"v":"1","id":"code_a1b2c","name":"代码-解析匹配结果","type":"code","description":"解析LLM输出的JSON，提取匹配的问题列表","group_params":[{"name":"入参","params":[{"key":"code_input","test":"input","type":"code_input","value":[{"key":"llm_output","type":"ref","label":"LLM-问题匹配/output","value":"llm_7e8f9.output"}],"required":true}]},{"name":"执行代码","params":[{"key":"code","type":"code","value":"import json\n\ndef main(llm_output: str) -> dict:\n    try:\n        result = json.loads(llm_output)\n        matched = result.get('matched_questions', [])\n        return {\n            'standard_question': result.get('standard_question', ''),\n            'matched_questions': [f\"{i}. {x['question']}\" for i, x in enumerate(matched)],\n            'questions_map': [x['qid'] for x in matched],\n            'question_count': str(len(matched))\n        }\n    except json.JSONDecodeError:\n        return {\n            'standard_question': '',\n            'matched_questions': [],\n            'questions_map': [],\n            'question_count': '0'\n        }","required":true}]},{"name":"出参","params":[{"key":"code_output","type":"code_output","value":[{"key":"standard_question","type":"str"},{"key":"matched_questions","type":"list"},{"key":"question_map","type":"list"},{"key":"question_count","type":"str"}],"global":"code:value.map(el => ({ label: el.key, value: el.key }))","required":true}]}]},"type":"flowNode","dragging":false,"measured":{"width":334,"height":726},"position":{"x":1098.4359921838034,"y":258.26420946748226},"selected":false},{"id":"output_d3e4f","data":{"v":"2","id":"output_d3e4f","name":"输出-问题列表","type":"output","description":"返回匹配的问题列表供用户选择","group_params":[{"params":[{"key":"message","type":"var_textarea_file","label":"true","value":{"msg":"找到 {{#code_a1b2c.question_count#}} 个相关问题：\n{{#code_a1b2c.matched_questions#}}","files":[]},"varZh":{"code_a1b2c.question_count":"代码-解析匹配结果/question_count","code_a1b2c.matched_questions":"代码-解析匹配结果/matched_questions"},"global":"key","required":true,"placeholder":"true"},{"key":"output_result","type":"output_form","label":"用户输入内容","value":{"type":"","value":""},"global":"value.type=input","options":[],"required":false}]}]},"type":"flowNode","dragging":false,"measured":{"width":334,"height":433},"position":{"x":1683.6405407511484,"y":916.3224307696421},"selected":false},{"id":"input_5g6h7","data":{"v":"3","id":"input_5g6h7","tab":{"value":"dialog_input","options":[{"key":"dialog_input","help":"true","label":"true"},{"key":"form_input","help":"true","label":"true"}]},"name":"输入-用户选择","type":"input","description":"接收用户选择的问题","group_params":[{"name":"接收文本","params":[{"key":"user_input","tab":"dialog_input","type":"var","label":"true","global":"key"}]},{"name":"","params":[{"key":"user_input_file","tab":"dialog_input","value":false,"groupTitle":true},{"key":"file_parse_mode","tab":"dialog_input","type":"select_parse